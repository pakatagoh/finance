# Keep the build context free of local state, credentials, and deployment data.
.git
.gitignore
.env
.env.*
*.pem
*.key
*.crt
secrets/
private/
deploy/
homelab/
Dockerfile*
compose*.override.yaml
# Personal Mise overrides and local test state must never enter image layers.
**/*.local.toml
.hermes/
**/__pycache__/
# Build only uses the shared and build overlays.
mise.development.toml
mise.development.lock
