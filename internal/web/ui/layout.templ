package ui

templ Shell(title string, nonce string, body templ.Component) {
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{ title } · Finance</title>
  <link rel="stylesheet" href="/static/css/app.css"/>
</head>
<body>
  <header class="navbar border-b border-base-300 bg-base-100"><div class="container mx-auto px-4"><a class="btn btn-ghost px-0 text-xl font-bold" href="/">Finance</a></div></header>
  <main class="container mx-auto max-w-6xl px-4 py-8">@body</main>
  <script nonce={ nonce } src="/static/js/htmx.min.js"></script>
  <script nonce={ nonce } src="/static/js/hx-live.min.js"></script>
  <script nonce={ nonce } src="/static/js/hx-csp.min.js"></script>
</body>
</html>
}

templ EmptyState(message string) {
<section class="card bg-base-100 shadow-sm"><div class="card-body"><p>{ message }</p></div></section>
}
