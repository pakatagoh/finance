package ui

templ Shell(title string, nonce string, body templ.Component) {
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{ title } · Finance</title>
  <link rel="stylesheet" href="/static/css/app.css"/>
</head>
<body>
  <header class="navbar border-b border-base-300 bg-base-100"><div class="mx-auto w-full max-w-6xl px-4"><a class="btn btn-ghost px-0 text-xl font-bold" href="/">Finance</a></div></header>
  <div class="mx-auto w-full max-w-6xl px-4 py-8">@body</div>
  <script nonce={ nonce } src="/static/js/htmx.min.js"></script>
  <script nonce={ nonce } src="/static/js/hx-live.min.js"></script>
  <script nonce={ nonce } src="/static/js/hx-csp.min.js"></script>
</body>
</html>
}

templ EmptyState(message string) {
<section class="card bg-base-100 shadow-sm"><div class="card-body"><p>{ message }</p></div></section>
}

templ OperationalError(nonce, message, retryURL, target string) {
<div class="alert alert-error items-start" role="alert" aria-live="assertive">
  <div><h2 class="font-semibold">{ message }</h2><p class="mt-1">Try again.</p><div class="mt-3"><a class="btn btn-sm btn-outline" href={ templ.URL(retryURL) } hx-get={ retryURL } hx-nonce={ nonce } hx-target={ target } hx-swap="outerHTML">Retry</a></div></div>
</div>
}

templ PageHeader(title, subtitle string) {
<div class="space-y-2"><h1 class="text-3xl font-bold tracking-tight">{ title }</h1><p class="text-base-content/70">{ subtitle }</p></div>
}
