package ui

import (
	"fmt"
	"net/url"
	"strconv"
	"time"

	"github.com/pakatagoh/finance/internal/storage"
)

var singapore = time.FixedZone("Singapore", 8*60*60)
func singaporeTime(t time.Time) string { return t.In(singapore).Format("02 Jan 2006 15:04") }
func signedAmount(minor int64, currency, direction string) string { sign := "-"; if direction == "credit" { sign = "+" }; return fmt.Sprintf("%s%s %.2f", sign, currency, float64(minor)/100) }
func suffix(s string) string { if s == "" { return "—" }; return "•••• " + s }
func pageURL(f storage.TransactionFilter, page int) string { v:=url.Values{}; if f.Bank!=""{v.Set("bank",f.Bank)};if f.Type!=""{v.Set("type",f.Type)};if f.Category!=""{v.Set("category",f.Category)};v.Set("page",strconv.Itoa(page));return "/transactions?"+v.Encode() }

templ TransactionsPage(nonce string, p storage.TransactionPage) {
	@Shell("Transactions", nonce, TransactionsResults(p))
}

templ TransactionsResults(p storage.TransactionPage) {
<section id="transaction-results" hx-history-elt>
  <div class="flex justify-between items-center mb-4"><h1 class="text-2xl font-bold">Transactions</h1><p>{ fmt.Sprintf("%d total", p.Total) }</p></div>
  <form method="get" action="/transactions" class="flex gap-2 mb-4" hx-get="/transactions" hx-target="#transaction-results" hx-push-url="true">
    <input name="bank" value={ p.Filter.Bank } placeholder="Bank" class="input input-bordered"/>
    <input name="type" value={ p.Filter.Type } placeholder="Type" class="input input-bordered"/>
    <input name="category" value={ p.Filter.Category } placeholder="Category" class="input input-bordered"/>
    <button class="btn btn-primary" type="submit">Filter</button>
  </form>
  if len(p.Items) == 0 {
    <div class="card bg-base-100 shadow-sm"><div class="card-body"><h2 class="card-title">No transactions yet</h2><p>New transactions will appear here after they are received from the bank tracker.</p></div></div>
  } else {
    <div class="overflow-x-auto"><table class="table"><thead><tr><th>Date (SGT)</th><th>Bank</th><th>Type</th><th>Merchant / Payee</th><th>Account</th><th>Category</th><th>Amount</th></tr></thead><tbody>
    for _, item := range p.Items {
      <tr><td>{ singaporeTime(item.OccurredAt) }</td><td>{ item.Bank }</td><td>{ item.Type }</td><td><a class="link" href={ templ.URL("/transactions/"+item.ID) }>{ item.MerchantPayee }</a></td><td>{ suffix(item.MaskedSuffix) }</td><td>{ item.Category }</td><td class="text-right">{ signedAmount(item.AmountMinor,item.Currency,item.Direction) }</td></tr>
    }
    </tbody></table></div>
  }
  if p.Total > 0 {
    <nav class="join mt-4" aria-label="Pagination">
    if p.Page > 1 {
      <a class="join-item btn" href={ templ.URL(pageURL(p.Filter,p.Page-1)) } hx-get={ pageURL(p.Filter,p.Page-1) } hx-target="#transaction-results" hx-push-url="true">Previous</a>
    }
    for n := 1; n <= (p.Total+storage.TransactionPageSize-1)/storage.TransactionPageSize; n++ {
      <a class="join-item btn" href={ templ.URL(pageURL(p.Filter,n)) } hx-get={ pageURL(p.Filter,n) } hx-target="#transaction-results" hx-push-url="true">{ strconv.Itoa(n) }</a>
    }
    if p.Page < (p.Total+storage.TransactionPageSize-1)/storage.TransactionPageSize {
      <a class="join-item btn" href={ templ.URL(pageURL(p.Filter,p.Page+1)) } hx-get={ pageURL(p.Filter,p.Page+1) } hx-target="#transaction-results" hx-push-url="true">Next</a>
    }
    </nav>
  }
</section>
}
